tyle="text;html=1;overflow=visible;align=center;verticalAlign=top;fontSize=12;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="605.9" y="139.2" width="22.5" height="17.9" as="geometry"/></mxCell><mxCell id="c208" value="&lt;i&gt;c&lt;/i&gt;&lt;sub&gt;N&lt;/sub&gt;" style="text;html=1;overflow=visible;align=center;verticalAlign=top;fontSize=12;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="901.9" y="139.2" width="22.5" height="17.9" as="geometry"/></mxCell><mxCell id="c209" value="&lt;i&gt;N&lt;/i&gt; = size of codebook 2&lt;br&gt;= bound on the number of&lt;br&gt;distinct discrete states (events)" style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=14;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="996.0" y="85.4" width="142.9" height="53.1" as="geometry"/></mxCell><mxCell id="c210" value="nearest prototype" style="text;html=1;overflow=visible;align=center;verticalAlign=bottom;fontSize=14;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="752.8" y="216.8" width="76.9" height="19.2" as="geometry"/></mxCell><mxCell id="c211" value="event &lt;i&gt;e&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt; ∈ {1, …, N}" style="text;html=1;overflow=visible;align=center;verticalAlign=middle;fontSize=17;fontColor=#0b0b0b;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="898.0" y="210.1" width="116.1" height="23.0" as="geometry"/></mxCell><mxCell id="c212" value="the discrete state" style="text;html=1;overflow=visible;align=center;verticalAlign=middle;fontSize=13;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="917.0" y="276.3" width="77.9" height="18.6" as="geometry"/></mxCell><mxCell id="c213" value="Encoder &lt;i&gt;E&lt;/i&gt;&lt;sub&gt;φ&lt;/sub&gt;" style="text;html=1;overflow=visible;align=center;verticalAlign=top;fontSize=16;fontColor=#0b0b0b;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="209.2" y="362.4" width="69.5" height="21.8" as="geometry"/></mxCell><mxCell id="c214" value="Codebook 1 loss (cell level)" style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=15;fontColor=#0b0b0b;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="378.4" y="360.6" width="131.7" height="21.1" as="geometry"/></mxCell><mxCell id="c215" value="Codebook 2 loss (grid level)" style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=15;fontColor=#0b0b0b;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="652.8" y="360.6" width="131.7" height="21.1" as="geometry"/></mxCell><mxCell id="c216" value="II   Event-transition head and agent" style="text;html=1;overflow=visible;align=left;verticalAlign=top;fontSize=20;fontColor=#0b0b0b;fontFamily=Helvetica;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="467.2" width="215.3" height="26.9" as="geometry"/></mxCell><mxCell id="c217" value="loop (clockwise):  &lt;i&gt;x&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt; → &lt;i&gt;e&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt; → ρ&lt;sub&gt;t&lt;/sub&gt; → &lt;i&gt;r̃&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt; → &lt;i&gt;a&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt; → &lt;i&gt;x&lt;/i&gt;&lt;sub&gt;t+1&lt;/sub&gt;" style="text;html=1;overflow=visible;align=left;verticalAlign=top;fontSize=15;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="416" y="469.6" width="271.6" height="20.5" as="geometry"/></mxCell><mxCell id="c218" value="Demon Attack" style="text;html=1;overflow=visible;align=center;verticalAlign=middle;fontSize=17;fontColor=#0b0b0b;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="76.7" y="647.7" width="70.6" height="23.7" as="geometry"/></mxCell><mxCell id="c219" value="ALE, 18 actions" style="text;html=1;overflow=visible;align=center;verticalAlign=middle;fontSize=14;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="76.2" y="685.1" width="71.5" height="19.8" as="geometry"/></mxCell><mxCell id="c220" value="DQN agent &lt;i&gt;Q&lt;/i&gt;&lt;sub&gt;ψ&lt;/sub&gt;(&lt;i&gt;x&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt;, ·)" style="text;html=1;overflow=visible;align=center;verticalAlign=middle;fontSize=17;fontColor=#0b0b0b;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="237.0" y="647.7" width="134.1" height="23.7" as="geometry"/></mxCell><mxCell id="c221" value="ε-greedy, replay, target net" style="text;html=1;overflow=visible;align=center;verticalAlign=middle;fontSize=14;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="242.4" y="685.1" width="123.1" height="19.8" as="geometry"/></mxCell><mxCell id="c222" value="&lt;i&gt;r̃&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt; = &lt;i&gt;r&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt; − λ ρ&lt;sub&gt;t&lt;/sub&gt;" style="text;html=1;overflow=visible;align=center;verticalAlign=middle;fontSize=17;fontColor=#0b0b0b;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="419.2" y="647.7" width="153.6" height="23.7" as="geometry"/></mxCell><mxCell id="c223" value="shaped reward" style="text;html=1;overflow=visible;align=center;verticalAlign=middle;fontSize=14;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="464.2" y="685.1" width="63.6" height="19.8" as="geometry"/></mxCell><mxCell id="c224" value="penalty ρ&lt;sub&gt;t&lt;/sub&gt;" style="text;html=1;overflow=visible;align=center;verticalAlign=middle;fontSize=17;fontColor=#0b0b0b;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="616.3" y="647.7" width="75.5" height="23.7" as="geometry"/></mxCell><mxCell id="c225" value="= p(&lt;i&gt;e&lt;/i&gt;&lt;sub&gt;t+1&lt;/sub&gt; | &lt;i&gt;e&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt;), the score" style="text;html=1;overflow=visible;align=center;verticalAlign=middle;fontSize=14;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="588.5" y="685.1" width="131.0" height="19.8" as="geometry"/></mxCell><mxCell id="c226" value="&lt;i&gt;a&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt;" style="text;html=1;overflow=visible;align=center;verticalAlign=bottom;fontSize=15;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="183.8" y="641.9" width="24.4" height="20.5" as="geometry"/></mxCell><mxCell id="c227" value="&lt;i&gt;x&lt;/i&gt;&lt;sub&gt;t+1&lt;/sub&gt;" style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=15;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="98.4" y="533.8" width="40.8" height="20.5" as="geometry"/></mxCell><mxCell id="c228" value="task loss, term 1 of 𝓛: maximise the number of kills,&lt;br&gt;then minimise the index &lt;i&gt;i&lt;/i&gt;&lt;sub&gt;last&lt;/sub&gt; of the last kill" style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=14;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="137.6" y="739.0" width="266.8" height="37.1" as="geometry"/></mxCell><mxCell id="c229" value="current event, one-hot over the &lt;i&gt;N&lt;/i&gt; events" style="text;html=1;overflow=visible;align=center;verticalAlign=middle;fontSize=14;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="934.6" y="507.7" width="170.7" height="19.8" as="geometry"/></mxCell><mxCell id="c230" value="&lt;i&gt;e&lt;/i&gt;&lt;sub&gt;1&lt;/sub&gt;" style="text;html=1;overflow=visible;align=right;verticalAlign=middle;fontSize=13;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="859.4" y="534.7" width="23.0" height="18.6" as="geometry"/></mxCell><mxCell id="c231" value="&lt;i&gt;e&lt;/i&gt;&lt;sub&gt;N&lt;/sub&gt;" style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=13;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="1060.8" y="534.7" width="23.0" height="18.6" as="geometry"/></mxCell><mxCell id="c232" value="next event &lt;i&gt;e&lt;/i&gt;&lt;sub&gt;t+1&lt;/sub&gt;" style="text;html=1;overflow=visible;align=right;verticalAlign=middle;fontSize=13;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="804.5" y="638.7" width="77.9" height="18.6" as="geometry"/></mxCell><mxCell id="c233" value="softmax:  p(&lt;i&gt;e&lt;/i&gt;&lt;sub&gt;t+1&lt;/sub&gt; | &lt;i&gt;e&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt;) over the &lt;i&gt;N&lt;/i&gt; events;  the bar at the observed &lt;i&gt;e&lt;/i&gt;&lt;sub&gt;t+1&lt;/sub&gt; is the penalty" style="text;html=1;overflow=visible;align=center;verticalAlign=middle;fontSize=14;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="786.7" y="732.8" width="370.6" height="19.2" as="geometry"/></mxCell><mxCell id="c234" value="one-layer perceptron &lt;i&gt;W&lt;/i&gt; ∈ ℝ&lt;sup&gt;N×N&lt;/sup&gt;:  one weight vector per event" style="text;html=1;overflow=visible;align=center;verticalAlign=middle;fontSize=15;fontColor=#0b0b0b;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="829.5" y="763.4" width="316.9" height="20.5" as="geometry"/></mxCell><mxCell id="c235" value="filled node =&lt;br&gt;current &lt;i&gt;e&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt;" style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=12;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="1092.0" y="571.7" width="57.6" height="32.6" as="geometry"/></mxCell><mxCell id="c236" value="&lt;i&gt;e&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt;" style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=15;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="968" y="405.8" width="24.4" height="20.5" as="geometry"/></mxCell><mxCell id="c237" value="Total loss  𝓛 =" style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=17;fontColor=#0b0b0b;fontFamily=Helvetica;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="841.8" width="129.2" height="23.7" as="geometry"/></mxCell><mxCell id="c238" value="min&lt;sub&gt;π&lt;/sub&gt; &lt;i&gt;i&lt;/i&gt;&lt;sub&gt;last&lt;/sub&gt; [ max&lt;sub&gt;π&lt;/sub&gt; Σ&lt;sub&gt;t&lt;/sub&gt; 𝟙(&lt;i&gt;r&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt; = 10) ]" style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=17;fontColor=#0b0b0b;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="215.2" y="842.1" width="329.0" height="23.0" as="geometry"/></mxCell><mxCell id="c239" value="+" style="text;html=1;overflow=visible;align=center;verticalAlign=middle;fontSize=17;fontColor=#0b0b0b;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="491.6" y="841.8" width="16.9" height="23.7" as="geometry"/></mxCell><mxCell id="c240" value="‖sg[&lt;i&gt;z&lt;/i&gt;&lt;sub&gt;e&lt;/sub&gt;] − &lt;i&gt;e&lt;/i&gt;‖² + β ‖&lt;i&gt;z&lt;/i&gt;&lt;sub&gt;e&lt;/sub&gt; − sg[&lt;i&gt;e&lt;/i&gt;]‖²" style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=17;fontColor=#0b0b0b;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="548.0" y="842.1" width="239.1" height="23.0" as="geometry"/></mxCell><mxCell id="c241" value="+" style="text;html=1;overflow=visible;align=center;verticalAlign=middle;fontSize=17;fontColor=#0b0b0b;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="827.6" y="841.8" width="16.9" height="23.7" as="geometry"/></mxCell><mxCell id="c242" value="‖sg[&lt;i&gt;g&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt;] − &lt;i&gt;c&lt;/i&gt;‖² + β ‖&lt;i&gt;g&lt;/i&gt;&lt;sub&gt;t&lt;/sub&gt; − sg[&lt;i&gt;c&lt;/i&gt;]‖² + γ 𝓛&lt;sub&gt;use&lt;/sub&gt;" style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=17;fontColor=#0b0b0b;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="884.0" y="842.1" width="385.8" height="23.0" as="geometry"/></mxCell><mxCell id="c243" value="task (replaces reconstruction): max kills, then min &lt;i&gt;i&lt;/i&gt;&lt;sub&gt;last&lt;/sub&gt;" style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=14;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="215.2" y="875.8" width="276.6" height="19.5" as="geometry"/></mxCell><mxCell id="c244" value="codebook 1 (cell level): unchanged" style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=14;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="548.0" y="875.8" width="144.3" height="19.5" as="geometry"/></mxCell><mxCell id="c245" value="codebook 2 (grid level): + usage of the &lt;i&gt;N&lt;/i&gt; prototypes" style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=14;fontColor=#52514e;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="884.0" y="875.8" width="214.4" height="19.5" as="geometry"/></mxCell><mxCell id="c246" value="sg = stop-gradient;  &lt;i&gt;e&lt;/i&gt;, &lt;i&gt;c&lt;/i&gt; = the selected entries of codebooks 1 and 2;  β = commitment weight;  γ 𝓛&lt;sub&gt;use&lt;/sub&gt; keeps all &lt;i&gt;N&lt;/i&gt; prototypes in use;  &lt;i&gt;i&lt;/i&gt;&lt;sub&gt;last&lt;/sub&gt; = time index of the last kill (+10);  gradients reach &lt;i&gt;E&lt;/i&gt;&lt;sub&gt;φ&lt;/sub&gt; through the straight-through estimator (∇&lt;sub&gt;z&lt;/sub&gt;𝓛)." style="text;html=1;overflow=visible;align=left;verticalAlign=middle;fontSize=13;fontColor=#8a8984;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="906.7" width="1103.5" height="18.6" as="geometry"/></mxCell><mxCell id="c247" value="" style="ellipse;aspect=fixed;fillColor=#2a78d6;strokeColor=none;strokeWidth=0.6;" vertex="1" parent="1"><mxGeometry x="352.4" y="361.2" width="20.0" height="20.0" as="geometry"/></mxCell><mxCell id="c248" value="" style="ellip